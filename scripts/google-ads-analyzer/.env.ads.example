# Copy this file to .env.ads (in the repo root) and fill in real values.
# .env.ads is listed in .gitignore — but double check `git status` before
# committing anything, since this file holds real credentials once filled in.

# From Google Cloud Console > APIs & Services > Credentials (OAuth client, "Desktop app" type)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# From Google Ads > Tools & Settings > API Center
GOOGLE_ADS_DEVELOPER_TOKEN=

# Generated once via: node scripts/google-ads-analyzer/get-refresh-token.mjs
GOOGLE_ADS_REFRESH_TOKEN=

# The Google Ads account to analyze, digits only, no dashes (found top-right in the Google Ads UI)
GOOGLE_ADS_CUSTOMER_ID=

# Only set this if the account above is managed under an agency/manager (MCC) account —
# then this is the manager account's ID, digits only, no dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
